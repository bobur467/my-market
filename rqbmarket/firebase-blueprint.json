{
  "entities": {
    "User": {
      "title": "User",
      "description": "App user profile information.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "photo": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "role", "createdAt"]
    },
    "Ad": {
      "title": "Ad",
      "description": "Marketplace advertisement for accounts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "category": { "type": "string", "enum": ["Instagram", "Telegram", "Premium", "Stars"] },
        "title": { "type": "string" },
        "followers": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string", "enum": ["$", "UZS", "₽"] },
        "description": { "type": "string" },
        "mail": { "type": "string", "enum": ["yes", "no"] },
        "phone": { "type": "string" },
        "photo": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "category", "title", "price", "status", "createdAt"]
    },
    "Rating": {
      "title": "Rating",
      "description": "Seller rating from buyers.",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "buyerId": { "type": "string" },
        "score": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sellerId", "buyerId", "score", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Ad report for fraud or fake info.",
      "type": "object",
      "properties": {
        "adId": { "type": "string" },
        "reporterId": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adId", "reporterId", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/ads/{adId}": {
      "schema": "Ad",
      "description": "Public advertisements."
    },
    "/ratings/{ratingId}": {
      "schema": "Rating",
      "description": "Seller ratings."
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Fraud reports."
    },
    "/users/{userId}/wishlist/{adId}": {
      "schema": { "type": "object", "properties": { "adId": { "type": "string" } } },
      "description": "User's saved ads."
    }
  }
}
